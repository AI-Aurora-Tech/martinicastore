# ---------------------------------------------------------------------------
# Supabase — copie este arquivo para ".env" e preencha com os dados do seu
# projeto (Supabase Dashboard → Project Settings → API).
#
# Sem estas variáveis, a aplicação roda em MODO DEMO (dados locais + login
# mock). Com elas preenchidas, passa a usar o banco de dados real.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key
