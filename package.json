{
  "name": "martinicastore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Loja virtual oficial do Martinica FC — camisas, acessórios e produtos licenciados.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --config vite.standalone.config.ts",
    "preview": "vite preview",
    "gen:seed": "node --experimental-strip-types scripts/gen-seed.ts > supabase/seed.sql",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
